[Unit]
Description=BetterNAS Weboberfläche und API
Requires=betternas-agent.service
After=betternas-agent.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=betternas
Group=betternas
ExecStart=/usr/bin/betternas-api
StateDirectory=betternas
StateDirectoryMode=0750
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/betternas/tls -/srv/vms/iso
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
