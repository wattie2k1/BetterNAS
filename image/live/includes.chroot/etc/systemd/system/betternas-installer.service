[Unit]
Description=BetterNAS-Installer
After=systemd-user-sessions.service getty-pre.target live-config.service
Conflicts=getty@tty1.service
Before=getty.target

[Service]
Type=idle
ExecStart=/usr/lib/betternas/installer-session.sh
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux LANG=C.UTF-8
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
